# Optional. When configured, getSTRs() reads from this API instead of mock data.
VITE_STR_API_URL=
DEMO_MODE=true

# Backend-only Brevo configuration. Never use the VITE_ prefix here.
BREVO_API_KEY=
BREVO_EDUARDO_EMAIL=jzeta-2024452@kinal.edu.gt
# Debe estar verificado en Brevo (Settings -> Senders) o el envio se rechaza
# con "the sender you used is not valid". Un Gmail solo se valida como
# remitente individual; no se puede autenticar como dominio.
BREVO_SENDER_EMAIL=kgarcia@red.com.gt
BREVO_SENDER_NAME=STRflow
APPROVAL_PUBLIC_URL=http://localhost:8787
AUTH_GLOBAL_EMAIL=gerentegeneral@red.com
AUTH_GLOBAL_PASSWORD=
AUTH_GUATEMALA_PASSWORD=
AUTH_ELSALVADOR_PASSWORD=
EXTERNAL_API_KEY=genera-una-api-key-segura

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=strflow

# --- JWT ---
JWT_SECRET=genera-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- API externa (solo lectura, header X-API-Key) ---
EXTERNAL_API_URL=https://sapapi.red.com.sv/api/Procesos/solicitudtraslado
EXTERNAL_API_KEY=
# Sincronizacion automatica al arrancar y cada N minutos. 0 = desactivada.
SYNC_INTERVAL_MINUTES=30

# --- Aprobacion por correo ---
APPROVAL_TOKEN_TTL_HOURS=72
CORS_ORIGIN=*
REVERT_WINDOW_SECONDS=10

# --- Escritura de la aprobacion en SAP ---
# El GET de arriba es de solo lectura. Para registrar la autorizacion en SAP
# hace falta un POST que todavia no existe (lo construye Camilo). Las
# credenciales las escribe quien aprueba, en el formulario del correo, y no se
# guardan. Mientras SAP_APPROVAL_ENABLED sea false el flujo corre en seco.
SAP_APPROVAL_URL=
SAP_APPROVAL_ENABLED=false
